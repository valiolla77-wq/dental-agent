# Example environment for the Dental Agent backend. Copy to `.env` and fill
# your real secret values there (`.env` is git-ignored).
#
# Database (SQLite by default). Point DATABASE_URL at an explicit path such as
# ./sample.db for local sample data (scripts/seed_sample.py refuses any other path).
# DATABASE_URL=sqlite+aiosqlite:///./sample.db

AGENT_LLM_PROVIDER=ollama
AGENT_LLM_MODEL=
AGENT_LLM_BASE_URL=
AGENT_LLM_TEMPERATURE=0

# Used when AGENT_LLM_PROVIDER=openai for an OpenAI-compatible endpoint with
# a custom base URL. Keep empty here; supply the real value in ignored .env.
AGENT_LLM_API_KEY=

# Per-request timeout (seconds) for the OpenAI-compatible endpoint. Local
# inference (e.g. LM Studio on CPU) often needs a much larger value than the
# 60s default.
AGENT_LLM_TIMEOUT_SECONDS=300

# Used only when AGENT_LLM_PROVIDER=openrouter. Keep the key empty here and
# supply the real value only in the ignored local .env or process environment.
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# Authentication
# Must be >= 32 random characters (the app refuses to start in production otherwise).
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Agent write-confirmation tokens are stored only as HMAC-SHA256 hashes.
# Use an independent random secret; never reuse JWT_SECRET. Issuance fails
# closed when this value is missing.
CONFIRMATION_HMAC_SECRET=
CONFIRMATION_TTL_SECONDS=300

# Deployment environment gate. Only the explicit values "development" or
# "test" enable development-only helpers (the fake SMS provider and the
# dev_otp field in OTP responses). Unset or any other value (including
# "production") disables them, so a misconfigured deployment fails safe.
APP_ENV=development

# ---------------------------------------------------------------------------
# SMS / OTP delivery
#
# OTP_PROVIDER=fake (default): development-only in-memory channel. The code is
#   returned as dev_otp only when APP_ENV is development/test. Never use in
#   production.
# OTP_PROVIDER=smsir: real delivery through the SMS.ir REST API v1.
# OTP_PROVIDER=bale: delivery through the clinic's Bale messenger bot. The
#   patient opens the bot once, taps "اشتراک شماره تماس" (request_contact) and
#   the app links the chat to that phone; codes are then sent to that chat.
#   Needs BALE_BOT_TOKEN (create the bot with @botfather inside Bale) and an
#   outbound HTTPS route to tapi.bale.ai. The in-process long-poll loop can
#   be switched off with BALE_POLLER_ENABLED=0.
#
# SMS.ir supports two modes. Verification templates are recommended for OTP:
#   1) Create/login to a template in the SMS.ir panel (e.g. "کد تایید شما:
#      #CODE#") and put its numeric id in SMSIR_VERIFY_TEMPLATE_ID. The
#      parameter name must match the #NAME# placeholder (default CODE).
#   2) Alternatively, set SMSIR_LINE_NUMBER to a service line enabled for
#      sending; the plain message body is used (bulk endpoint).
# If a template id is set it wins over the service line. If neither is set,
# OTP requests fail closed with COMMON_SERVICE_UNAVAILABLE. SMSIR_API_KEY is
# mandatory for smsir; keep it only in the ignored .env. With OTP_PROVIDER=bale
# a missing BALE_BOT_TOKEN fails closed the same way.
# ---------------------------------------------------------------------------
OTP_PROVIDER=fake
SMSIR_API_KEY=
SMSIR_VERIFY_TEMPLATE_ID=
SMSIR_VERIFY_PARAMETER=CODE
SMSIR_LINE_NUMBER=
BALE_BOT_TOKEN=
BALE_POLLER_ENABLED=1
BALE_POLL_TIMEOUT_SECONDS=25

# Login brute-force protection (sliding window over FAILED password
# attempts only). A successful login clears the account counter. The
# limiter is in-memory and per-process; see app/auth/rate_limit.py.
LOGIN_RATE_FAILED_ATTEMPTS_PER_PHONE=5
LOGIN_RATE_FAILED_ATTEMPTS_PER_IP=20
LOGIN_RATE_WINDOW_SECONDS=900

# Abuse protection (all optional; values shown are the defaults).
# OTP issuance caps protect SMS credit; per-user limits protect LLM cost.
OTP_PHONE_DAILY_LIMIT=10
OTP_GLOBAL_HOURLY_LIMIT=300
CHAT_RATE_LIMIT_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
FEEDBACK_RATE_LIMIT_REQUESTS=10
FEEDBACK_RATE_LIMIT_WINDOW_SECONDS=3600
