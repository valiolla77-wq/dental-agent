AGENT_LLM_PROVIDER=ollama
AGENT_LLM_MODEL=
AGENT_LLM_BASE_URL=
AGENT_LLM_TEMPERATURE=0

# Used only when AGENT_LLM_PROVIDER=openrouter. Keep the key empty here and
# supply the real value only in the ignored local .env or process environment.
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# Authentication
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Agent write-confirmation tokens are stored only as HMAC-SHA256 hashes.
# Use an independent random secret; never reuse JWT_SECRET. Issuance fails
# closed when this value is missing.
CONFIRMATION_HMAC_SECRET=
CONFIRMATION_TTL_SECONDS=300

# Deployment environment gate. Only the explicit values "development" or
# "test" enable development-only helpers (the fake SMS provider and the
# dev_otp field in OTP responses). Unset or any other value (including
# "production") disables them, so a misconfigured deployment fails safe.
APP_ENV=development

# Login brute-force protection (sliding window over FAILED password
# attempts only). A successful login clears the account counter. The
# limiter is in-memory and per-process; see app/auth/rate_limit.py.
LOGIN_RATE_FAILED_ATTEMPTS_PER_PHONE=5
LOGIN_RATE_FAILED_ATTEMPTS_PER_IP=20
LOGIN_RATE_WINDOW_SECONDS=900
