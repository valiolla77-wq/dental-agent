# Python bytecode and caches
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Local environment files and secrets
.env
.env.*
!.env.example
.secrets/
*.pem
*.key

# Local databases and logs
*.db
*.sqlite
*.sqlite3
*.log
*.err

# Test, coverage, and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Project run outputs
output/
tmp/
.tmp-run.out
openapi-report.json

# Node dependencies (webapp has its own .gitignore; this covers the root)
node_modules/

# Local archives and exports
*.zip

# Operating system files
.DS_Store
Thumbs.db
